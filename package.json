    "@angular/compiler-cli": "^21.2.25",
    "@eslint/js": "^10.0.1",
    "@types/file-saver": "^2.0.7",
    "angular-eslint": "21.4.0",
    "eslint": "^10.3.0",
    "jsdom": "^27.4.0",
    "prettier": "^3.9.9",
    "typescript": "~5.9.3",
    "typescript-eslint": "8.59.2",
    "vitest": "~4.0.18"
  }
