{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "SRI": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss",
          "changeDetection": "OnPush"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/sri",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": [
              "node_modules/@fontsource/figtree/400.css",
              "node_modules/@fontsource/figtree/500.css",
              "node_modules/@fontsource/figtree/600.css",
              "node_modules/@fontsource/figtree/700.css",
              "node_modules/@fontsource/noto-sans-devanagari/devanagari-400.css",
              "node_modules/@fontsource/noto-sans-devanagari/devanagari-500.css",
              "node_modules/@fontsource/noto-sans-devanagari/devanagari-600.css",
              "node_modules/@fontsource/noto-sans-devanagari/devanagari-700.css",
              "src/styles.scss"
            ],
            "stylePreprocessorOptions": {
              "includePaths": [
                "src/styles"
              ]
            },
            "allowedCommonJsDependencies": [
              "jszip",
              "file-saver"
            ]
          },
          "configurations": {
            "production": {
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.prod.ts"
                }
              ],
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "720kB",
                  "maximumError": "900kB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "8kB",
                  "maximumError": "16kB"
                }
              ],
              "outputHashing": "all",
              "index": {
                "input": "src/index.prod.html",
                "output": "index.html"
              },
              "optimization": {
                "scripts": true,
                "styles": {
                  "minify": true,
                  "inlineCritical": false
                },
                "fonts": true
              }
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            },
            "mock": {
              "outputPath": "dist/mock",
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.mock.ts"
                },
                {
                  "replace": "src/app/core/demo/demo-providers.ts",
                  "with": "src/app/core/demo/demo-providers.mock.ts"
                }
              ]
            },
            "demo": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "850kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "8kB",
                  "maximumError": "16kB"
                }
              ],
              "outputHashing": "all",
              "index": {
                "input": "src/index.prod.html",
                "output": "index.html"
              },
              "optimization": {
                "scripts": true,
                "styles": {
                  "minify": true,
                  "inlineCritical": false
                },
                "fonts": true
              },
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.mock.ts"
                },
                {
                  "replace": "src/app/core/demo/demo-providers.ts",
                  "with": "src/app/core/demo/demo-providers.mock.ts"
                }
              ],
              "outputPath": "dist/demo"
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "SRI:build:production"
            },
            "development": {
              "buildTarget": "SRI:build:development"
            },
            "mock": {
              "buildTarget": "SRI:build:mock"
            },
            "demo": {
              "buildTarget": "SRI:build:demo"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "tsconfig.spec.json",
            "runner": "vitest",
            "providersFile": "src/test-providers.ts",
            "setupFiles": [
              "src/testing/setup.ts"
            ]
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "src/**/*.ts",
              "src/**/*.html"
            ]
          }
        }
      }
    }
  },
  "cli": {
    "analytics": false,
    "schematicCollections": [
      "angular-eslint"
    ]
  }
}
